PROJECT_NAME="CIS AI Service"
ENV="development"
PORT=8000

# Supabase Postgres connection string (async, pgvector-enabled)
DATABASE_URL="postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-luna"

# Embeddings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# CORS - comma is not used; pass a JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["*"]
