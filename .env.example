PROJECT_NAME="CIS AI Service"
ENV="development"
PORT=8000

# Supabase Postgres connection string (async, pgvector-enabled). Prefer the transaction
# pooler (below) - the direct db.<ref>.supabase.co host resolves IPv6-only, which fails
# outright on networks without real IPv6 routing.
DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-luna"

# Embeddings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# F5 Coordinated-Network Detector (PRD Section 10) - optional, sane default below.
# The only F5 setting left here: every detection-pipeline tunable (PRD 10.11) is
# sent in full by the backend on every POST /api/v1/detection/runs call now, not
# read from config. See docs/COORDINATION.md.
# COORDINATION_MULTILINGUAL_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# CORS - comma is not used; pass a JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["*"]

# Logging - JSON auto-enabled in production; set LOG_LEVEL=DEBUG to also enable SQL echo
LOG_LEVEL="INFO"
# LOG_JSON=true

# Go backend integration - see docs/AI-INTEGRATION.md in the CIS-Backend repo.
# Both keys are optional; leave empty when both services are only reachable over a
# private network (the current deployment).
BACKEND_URL=""
# AI_SERVICE_API_KEY=
# INTERNAL_API_KEY=

# One Google Cloud project API key, two APIs enabled on it: YouTube Data API v3
# (crawler, below - REQUIRED, the crawler refuses to run without it, see
# docs/CRAWLER.md) and Fact Check Tools API (this service's Falseness fallback,
# still optional/skips silently when unset - see docs/SOURCES.md).
GOOGLE_API_KEY="AIza..."
# BMKG_ADM4_CODES=["31.71.03.1001"]  # Kepmendagri 100.1.1-6117/2022 adm4 codes; default is Kemayoran only

# --- crawler/ (separate component, own Cloud Run Job - see docs/CRAWLER.md) ---
# Read from this same .env for local dev convenience; unset in production, injected
# directly on the Job instead. Everything below is optional/empty by default - the
# crawler runs and exits cleanly doing nothing until these are set (Phase 2 setup).
AI_SERVICE_URL="http://localhost:8000"
RSS_FEED_URLS=["https://www.antaranews.com/rss/terkini.xml", "https://www.antaranews.com/rss/metro.xml", "https://www.cnnindonesia.com/nasional/rss", "https://www.republika.co.id/rss", "https://rss.tempo.co/nasional"]
# TELEGRAM_CHANNELS=["some_public_channel"]
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=
# YOUTUBE_SEARCH_QUERIES=["banjir jakarta", "kualitas udara jakarta"]  # uses GOOGLE_API_KEY above
